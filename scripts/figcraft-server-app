#!/usr/bin/env bash
# FigCraft Server App Launcher
# Launches the FigCraft collaboration server, opens the design file,
# and automatically shuts down the server when FigCraft closes.

set -e

DEFAULT_FILE="/home/jojo/Downloads/sb.fig"
TARGET_FILE="${1:-$DEFAULT_FILE}"

# Locate FigCraft binary
if [ -x "/home/jojo/ArtCraft/figcraft-0.16.0-linux-x86_64.AppImage" ]; then
    FIGCRAFT_BIN="/home/jojo/ArtCraft/figcraft-0.16.0-linux-x86_64.AppImage"
elif command -v figcraft >/dev/null 2>&1; then
    FIGCRAFT_BIN="$(command -v figcraft)"
else
    FIGCRAFT_BIN="/usr/bin/figcraft"
fi

# Cleanup on exit
cleanup() {
    echo "FigCraft session ended. Stopping collab server..."
    /usr/bin/fish -c "fig-server stop" >/dev/null 2>&1 || true
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i ai.storyteller.figcraft "FigCraft Collab Server" "Server stopped cleanly."
    fi
}
trap cleanup EXIT INT TERM

# Start collaboration server in background via fish function
/usr/bin/fish -c "fig-server start-bg" >/dev/null 2>&1 || true

# Wait briefly for server healthz
for i in {1..10}; do
    if curl -sf --max-time 1 http://127.0.0.1:47900/healthz >/dev/null 2>&1; then
        break
    fi
    sleep 0.2
done

# Grab Tailscale IP for the notification
TS_IP=$(tailscale ip -4 2>/dev/null || echo "192.168.20.5")

if command -v notify-send >/dev/null 2>&1; then
    notify-send -i ai.storyteller.figcraft "FigCraft Collab Server" "🟢 Server online!\nTailscale: ws://${TS_IP}:47900/\nOpening $(basename "$TARGET_FILE")..."
fi

# Launch FigCraft with the target file (blocks until window is closed)
if [ -f "$TARGET_FILE" ]; then
    "$FIGCRAFT_BIN" "$TARGET_FILE"
else
    "$FIGCRAFT_BIN"
fi
