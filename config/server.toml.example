# Server config template
# Copy to ~/figcraft/figcraft-data/server.toml and customize.
# The server picks this up automatically on start.

listen = "0.0.0.0:47900"
data   = "./figcraft-data"

# Uncomment ONE of these depending on your network setup:

# Option 1: Tailscale VPN (recommended — private, encrypted, works anywhere)
# public_url = "ws://100.x.x.x:47900/"   # replace with: tailscale ip -4

# Option 2: Local Network (same Wi-Fi only)
# public_url = "ws://192.168.1.50:47900/" # replace with your LAN IP

# Option 3: Reverse Proxy / Public Tunnel (Cloudflare Tunnel, Tailscale Funnel)
# public_url = "wss://figcraft.your-domain.com/"
